rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Add a document named with the Firebase Authentication UID in /admins
    // to grant a signed-in user access to the dashboard.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Login checks only the current user's role/membership documents.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Customers are keyed by their Firebase Authentication UID. A signed-in
    // user may create their own minimal profile at registration; administrators
    // manage and list the customer records from the dashboard.
    match /customers/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow get: if signedIn() && request.auth.uid == uid || isAdmin();
      allow list, update, delete: if isAdmin();
    }

    match /{collection}/{document} {
      allow read, write: if isAdmin() && collection in [
        'products', 'categories', 'orders', 'settings'
      ];
    }
  }
}
